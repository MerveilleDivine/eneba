{
  "name": "eneba",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.9",
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": "22.23.5"
  },
  "scripts": {
    "test:browser": "playwright test",
    "test:tooling": "node --test scripts/tooling.test.mjs",
    "audit:web": "npm audit --audit-level=moderate",
    "audit:api": "node scripts/run-go.mjs run golang.org/x/vuln/cmd/govulncheck@v1.9.0 ./...",
    "audit": "npm run audit:web && npm run audit:api",
    "history:export": "node scripts/export-history.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dev": "concurrently --kill-others --names api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/run-go.mjs run ./cmd/server",
    "dev:web": "npm run dev --workspace web",
    "db:local:start": "powershell -NoProfile -File scripts/local-postgres.ps1 -Action Start",
    "db:local:stop": "powershell -NoProfile -File scripts/local-postgres.ps1 -Action Stop",
    "db:local:status": "powershell -NoProfile -File scripts/local-postgres.ps1 -Action Status",
    "db:provision": "node scripts/run-go.mjs --bootstrap run ./cmd/db provision",
    "db:migrate": "node scripts/run-go.mjs run ./cmd/db migrate",
    "db:status": "node scripts/run-go.mjs run ./cmd/db status",
    "db:seed": "node scripts/run-go.mjs run ./cmd/db seed",
    "check:format": "node scripts/check-prettier.mjs && node scripts/check-go-format.mjs",
    "hooks:install": "git config --local core.hooksPath .githooks",
    "format": "prettier --write .",
    "verify:api": "node scripts/run-go.mjs vet ./... && node scripts/run-go.mjs test ./... && node scripts/run-go.mjs build ./...",
    "verify:web": "npm run typecheck --workspace web && npm run lint --workspace web && npm run test --workspace web && npm run build --workspace web",
    "verify": "npm run check:format && npm run test:tooling && npm run verify:api && npm run verify:web",
    "test:integration": "node scripts/run-go.mjs test -tags=integration -p 1 ./... -count=1 -v"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "concurrently": "10.0.7",
    "prettier": "3.10.1"
  },
  "overrides": {
    "eslint": {
      "minimatch": "11.0.1"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
