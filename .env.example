# Local connection URLs are generated by npm run db:provision.
# For an existing PostgreSQL instance, create isolated owner/application roles first.
APP_ENV=development
PORT=8080
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgres://eneba_dev_app:replace_me@127.0.0.1:5433/eneba_dev?sslmode=disable
MIGRATION_DATABASE_URL=postgres://eneba_dev_owner:replace_me@127.0.0.1:5433/eneba_dev?sslmode=disable
TEST_DATABASE_URL=postgres://eneba_test_app:replace_me@127.0.0.1:5433/eneba_test?sslmode=disable
TEST_MIGRATION_DATABASE_URL=postgres://eneba_test_owner:replace_me@127.0.0.1:5433/eneba_test?sslmode=disable
